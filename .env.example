# Identificação da conta e regiões que serão monitoradas.
# Separe as regiões por vírgula, sem espaços.
AWS_ACCOUNT_ID=111111111111
AWS_REGIONS=sa-east-1,us-east-1,us-west-2

# Região padrão usada apenas pelo SDK para operações globais, como STS.
AWS_REGION=sa-east-1

# Credenciais de um usuário IAM com a política de iam-policy.json
AWS_ACCESS_KEY_ID=AKIAEXEMPLO
AWS_SECRET_ACCESS_KEY=substitua-pela-secret-key

# Preencha somente se estiver usando credenciais temporárias
AWS_SESSION_TOKEN=

# Credencial e endpoint do SigNoz Cloud
SIGNOZ_INGESTION_KEY=substitua-pela-chave-do-signoz
